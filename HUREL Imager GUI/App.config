<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- 테스트 모드 활성화하려면 value="true" 또는 "1" 로 변경 -->
    <add key="TestMode" value="false" />
    <!-- RGBD 이미지 저장 활성화 여부 (true: 저장, false: 저장 안 함) -->
    <add key="SaveRgbdFrameEnabled" value="true" />
    <!-- RGBD 이미지 저장 시간 간격 (초 단위, 0.0이면 매 프레임마다 저장, 예: 1.0 = 1초마다) -->
    <add key="RgbdFrameSaveInterval" value="1.0" />
  </appSettings>
</configuration>


